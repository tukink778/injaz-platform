# انسخ هذا الملف إلى ".env" بجانب wsgi.py وعبّئ القيم. لا ترفع ".env" إلى أي مستودع (مستثنى في .gitignore).
# متغيرات البيئة الفعلية في الخادم لها الأولوية على هذا الملف.

# ---- الدومين والرابط العام (يدخل في رمز QR وروابط التحميل والبريد) ----
INJAZ_BASE_URL=https://injaz.example.edu
# اختياري: يرفض أي ترويسة Host غير هذه (مفصولة بفواصل)
INJAZ_ALLOWED_HOSTS=injaz.example.edu
# 1 عند التشغيل خلف HTTPS: كوكيز آمنة + HSTS
INJAZ_HTTPS=1
# 1 عند التشغيل خلف Nginx/Caddy على نفس الجهاز (للثقة بعنوان العميل الحقيقي)
INJAZ_BEHIND_PROXY=1
INJAZ_HOST=127.0.0.1
INJAZ_PORT=8080

# ---- التخزين (قاعدة SQLite + ملفات PDF المشفّرة + Excel المؤقت + النسخ الاحتياطية) ----
# مسار مجلد البيانات؛ ضعه على قرص دائم يُنسخ احتياطياً. الافتراضي ./data
# INJAZ_DATA_DIR=/var/lib/injaz
# مفتاح التشفير الرئيسي (اختياري). بدونه يُولَّد ملف data/.keys تلقائياً.
# لتوليد مفتاح:  python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# احفظ نسخة منه خارج السيرفر: فقدانه = فقدان القدرة على قراءة كل البيانات.
# INJAZ_MASTER_KEY=

# ---- البريد الإلكتروني (SMTP). بدون HOST يعمل النظام بوضع الاختبار (يحفظ الرسائل في data/outbox) ----
INJAZ_SMTP_HOST=
INJAZ_SMTP_PORT=587
# starttls (المنفذ 587) | ssl (المنفذ 465) | none
INJAZ_SMTP_SECURITY=starttls
INJAZ_SMTP_USER=
INJAZ_SMTP_PASS=
INJAZ_SMTP_FROM=certificates@example.edu

# ---- النسخ الاحتياطي ----
# عدد النسخ المحتفَظ بها عند تنفيذ: python manage.py backup
INJAZ_BACKUP_KEEP=14

# ---- التذييل (اختياري) ----
# رابط يُجعل عليه اسم المطوّر (http/https فقط)
# INJAZ_DEVELOPER_URL=

# ---- تشغيل Chromium داخل حاويات Docker (لا تفعّله خارج الحاويات) ----
# INJAZ_CHROMIUM_NOSANDBOX=1
