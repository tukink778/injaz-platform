# انسخ هذا الملف إلى ".env" بجانب wsgi.py وعبّئ القيم. لا ترفع ".env" إلى أي مستودع (مستثنى في .gitignore).
# متغيرات البيئة الفعلية في الخادم لها الأولوية على هذا الملف.

# ---- الدومين والرابط العام (يدخل في رمز QR وروابط التحميل والبريد) ----
INJAZ_BASE_URL=https://injaz.example.edu
# اختياري: يرفض أي ترويسة Host غير هذه (مفصولة بفواصل)
INJAZ_ALLOWED_HOSTS=injaz.example.edu
# 1 عند التشغيل خلف HTTPS: كوكيز آمنة + HSTS
INJAZ_HTTPS=1
# 1 عند التشغيل خلف Nginx/Caddy على نفس الجهاز (للثقة بعنوان العميل الحقيقي)
INJAZ_BEHIND_PROXY=1
INJAZ_HOST=127.0.0.1
INJAZ_PORT=8080

# ---- التخزين (قاعدة SQLite + ملفات PDF المشفّرة + Excel المؤقت + النسخ الاحتياطية) ----
# مسار مجلد البيانات؛ ضعه على قرص دائم يُنسخ احتياطياً. الافتراضي ./data
# INJAZ_DATA_DIR=/var/lib/injaz
# مفتاح التشفير الرئيسي (اختياري). بدونه يُولَّد ملف data/.keys تلقائياً.
# لتوليد مفتاح:  python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# احفظ نسخة منه خارج السيرفر: فقدانه = فقدان القدرة على قراءة كل البيانات.
# INJAZ_MASTER_KEY=

# ---- البريد الإلكتروني (SMTP). بدون HOST يعمل النظام بوضع الاختبار (يحفظ الرسائل في data/outbox) ----
INJAZ_SMTP_HOST=
INJAZ_SMTP_PORT=587
# starttls (المنفذ 587) | ssl (المنفذ 465) | none
INJAZ_SMTP_SECURITY=starttls
INJAZ_SMTP_USER=
INJAZ_SMTP_PASS=
INJAZ_SMTP_FROM=certificates@example.edu

# ---- النسخ الاحتياطي ----
# عدد النسخ المحتفَظ بها عند تنفيذ: python manage.py backup
INJAZ_BACKUP_KEEP=14

# ---- التذييل (اختياري) ----
# رابط يُجعل عليه اسم المطوّر (http/https فقط)
# INJAZ_DEVELOPER_URL=

# ---- تشغيل Chromium داخل حاويات Docker (لا تفعّله خارج الحاويات) ----
# INJAZ_CHROMIUM_NOSANDBOX=1

# ---- ربط حسابات البريد (OAuth 2.0): كل موظف يربط بريده الشخصي دون مشاركة كلمة المرور ----
# تُنشأ من Microsoft Entra وGoogle Cloud (الخطوات في docs/EMAIL_INTEGRATION.md). اتركها فارغة لتعطيل المزوّد.
# يتطلب INJAZ_BASE_URL بصيغة https:// (يُقبل http فقط لـ localhost). Redirect URI: {INJAZ_BASE_URL}/account/email/callback/{microsoft|google}
INJAZ_MS_CLIENT_ID=
INJAZ_MS_CLIENT_SECRET=
# common = أي حساب Microsoft (عمل/مدرسة/شخصي) · أو معرّف المستأجر (Tenant ID) لحصر الربط بمؤسستك فقط
INJAZ_MS_TENANT=common
INJAZ_GOOGLE_CLIENT_ID=
INJAZ_GOOGLE_CLIENT_SECRET=

# ---- PostgreSQL (Neon) — للإنتاج على Render ----
# عند ضبط DATABASE_URL تُستخدم PostgreSQL بدل SQLite. لا تضع الرابط الحقيقي في هذا الملف ولا في GitHub:
# ضعه في Render > Environment كمتغير سري. الصيغة (مثال شكلي فقط):
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# (يعمل أيضاً INJAZ_DATABASE_URL داخل .env محلياً؛ DATABASE_URL يُقرأ من بيئة النظام فقط)
# DATABASE_URL=
# INJAZ_DB_POOL_MAX=12        # أقصى اتصالات للنسخة الواحدة (Neon المجاني محدود؛ 5-10 كافٍ لنسخة واحدة)
# INJAZ_DB_CONNECT_WAIT=30    # ثوانٍ؛ Neon يحتاج بضع ثوانٍ لإيقاظ القاعدة بعد الخمول
# INJAZ_DB_SSLMODE=           # الافتراضي require لغير المحلي
# INJAZ_DB_SCHEMA=            # للاختبار فقط (لا تستخدمه مع رابط -pooler)
# مفتاح التشفير الرئيسي إلزامي عند استخدام PostgreSQL: لا يُولَّد تلقائياً (انظر docs/POSTGRES_NEON_RENDER.md)
# INJAZ_MASTER_KEY=
# على Render: INJAZ_BEHIND_PROXY=1 و INJAZ_TRUSTED_PROXY=* و INJAZ_PROXY_COUNT=1
# INJAZ_TRUSTED_PROXY=
# INJAZ_PROXY_COUNT=
